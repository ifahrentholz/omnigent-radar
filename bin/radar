#!/usr/bin/env bash
# radar — start the routing orchestrator in the current project.
#
#   cd <projekt> && radar        interaktive Session (du schreibst zuerst)
#   radar --log                  dito, Transkript nach ~/.omnigent/logs/
#   radar -p "frage"             HEADLESS: ein Request, dann Ende
#
# Zu -p: es setzt KEINE erste Nachricht in einem REPL ab. Omnigent läuft einmal
# durch und beendet sich, sobald ein Prompt gesetzt ist (cli.py: "run_chat runs
# one-shot and exits when initial_message is set"). Eine interaktive Session
# lässt sich nur zusammen mit --resume/--continue vorbelegen, was den Kontext
# der alten Konversation mitschleppt. Es gibt also keinen Weg, radar in einer
# frischen Session zuerst sprechen zu lassen — er führt seine erste Antwort
# stattdessen mit dem Projektstatus an, siehe "Session start" in
# agents/radar/config.yaml.
#
# Alle Argumente gehen unverändert an `omnigent run`.
set -euo pipefail

BUNDLE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/agents/radar"
exec omnigent run "$BUNDLE" "$@"
