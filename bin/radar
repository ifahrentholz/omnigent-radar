#!/usr/bin/env bash
# radar — start the routing orchestrator in the current directory.
#
#   cd <projekt> && radar        interaktive Session (du schreibst zuerst)
#   radar -p "frage"             HEADLESS: ein Request, dann Ende
#
# Alle Argumente gehen an `omnigent run` weiter. `--log` wird automatisch
# gesetzt, AUSSER es ist ein Prompt dabei: mit -p läuft Omnigent headless durch
# und lehnt --log ab ("only supported in interactive REPL mode").
set -euo pipefail

# Den Bundle-Pfad auch durch einen Symlink hindurch auflösen — installiert wird
# als Symlink in ~/.local/bin, und macOS kennt kein `readlink -f`.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
BUNDLE="$(cd -P "$(dirname "$src")/.." && pwd)/agents/radar"

if [ ! -f "$BUNDLE/config.yaml" ]; then
  echo "radar: kein Bundle unter $BUNDLE — Repo unvollständig oder verschoben?" >&2
  exit 1
fi
if ! command -v omnigent >/dev/null 2>&1; then
  echo "radar: 'omnigent' ist nicht auf dem PATH. Siehe https://omnigent.ai/" >&2
  exit 1
fi

# Kein cd: radar läuft im aktuellen Verzeichnis. Ohne Repo bleibt die
# Changed-Files-Ansicht leer (sie liest `git status`), gestartet wird trotzdem.
if ! git rev-parse --git-dir >/dev/null 2>&1; then
  echo "radar: $PWD ist kein git-Repo — die Changed-Files-Ansicht bleibt leer." >&2
fi

for arg in "$@"; do
  case "$arg" in
    -p|--prompt|-p*|--prompt=*) exec omnigent run "$BUNDLE" "$@" ;;
  esac
done
exec omnigent run "$BUNDLE" --log "$@"
